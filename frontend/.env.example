# ==============================================================================
# MENX Frontend Environment Variables (.env.example)
# Client-Safe Variables Only (VITE_ prefixed)
# DO NOT place SUPABASE_SECRET_KEY or any administrative secrets here!
# ==============================================================================

# Application Branding & Metadata
VITE_APP_NAME="MENX"
VITE_APP_TAGLINE="Modern Men's Fashion & Lifestyle"

# Backend REST API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Public Client Config (Safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
