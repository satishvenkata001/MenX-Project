# ==============================================================================
# MENX Root Environment Variables Template
# ==============================================================================
# Copy this file to .env or refer to frontend/.env.example and backend/.env.example
# NEVER commit actual secrets or production credentials.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Frontend App Config (Client-safe)
VITE_APP_NAME="MENX"
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Backend Server Config (Server-only)
PORT=5000
FRONTEND_URL=https://menx.shop,https://www.menx.shop,http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# CRITICAL: Secret key MUST ONLY be placed on backend, never exposed to client
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Direct PostgreSQL Connection String for Database Migrations (Optional)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
