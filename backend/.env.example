# ==============================================================================
# MENX Backend Environment Variables (.env.example)
# Server-Only Configuration - NEVER expose this file or commit real secrets
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Application URL for CORS (comma-separated for multiple origins e.g. https://menx.shop,https://www.menx.shop,http://localhost:5173)
FRONTEND_URL=https://menx.shop,https://www.menx.shop,http://localhost:5173

# Supabase Credentials (Backend Privileged Access)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY has server-side privileges.
# Keep strictly confidential on backend server only.
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Direct PostgreSQL Connection String for Database Migrations (Optional)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# API Rate Limiting Configuration (Multi-Tier Architecture)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
ADMIN_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=15
REFRESH_RATE_LIMIT_MAX=60
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_MS=60000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
